# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Ces deux valeurs sont publiques (exposées au navigateur) : c'est normal.
NEXT_PUBLIC_SUPABASE_URL=https://ydwlakmzqlvqetbevlwq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_6vUwP94F1K2x_bLGd96p9w_CB6ZIFrv

# SECRET. Contourne la RLS — ne doit JAMAIS être préfixée NEXT_PUBLIC_, ni
# importée dans un composant client. Utilisée uniquement par le webhook Stripe
# et le script d'import.
# À récupérer : Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stripe  (optionnel : sans ces clés, le site fonctionne, le paiement est
#          simplement désactivé avec un message explicite)
# ---------------------------------------------------------------------------
# Dashboard Stripe → Développeurs → Clés API (commencer en mode test)
STRIPE_SECRET_KEY=

# Obtenu avec `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# en local, ou dans Dashboard → Développeurs → Webhooks en production.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Contact  (optionnel : sans clé, le site fonctionne, le formulaire répond
#           juste que l'envoi est momentanément indisponible)
# ---------------------------------------------------------------------------
# resend.com → API Keys. Le formulaire de contact de l'accueil envoie par ce
# biais, depuis onboarding@resend.dev (pas de DNS à configurer).
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire. Optionnel — par défaut
# tomsallepro@gmail.com (voir src/lib/env.ts).
CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Utilisée pour les URLs absolues (Open Graph, redirections Stripe, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
